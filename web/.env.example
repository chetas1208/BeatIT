# HeartTwin web (Next.js + CopilotKit) — environment
# Copy to .env.local and fill in. All .env* files are gitignored.

# Backend origin (HeartTwin FastAPI, served under /api/v1). The browser uses
# this for REST + the SSE trace stream, and the CopilotKit route derives the
# /copilotkit origin from it.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Server-only override for the CopilotKit route's backend origin.
# Optional — defaults to NEXT_PUBLIC_API_BASE when unset.
# API_BASE=http://localhost:8000/api/v1

# Provider-neutral model runtime. These server-only values drive both the
# Next.js CopilotKit route and the FastAPI backend.
MODEL_ENABLED=true
MODEL_API_PROTOCOL=openai-compatible
MODEL_API_KEY=REPLACE_WITH_MODEL_API_KEY
MODEL_BASE_URL=http://localhost:9000/v1
MODEL_NAME=REPLACE_WITH_MODEL_NAME
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2
INTELLIGENCE_PROVIDER=generic

# Optional first-party OpenAI provider; disabled by default.
OPENAI_ENABLED=false
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=REPLACE_WITH_OPENAI_MODEL
