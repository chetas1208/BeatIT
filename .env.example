# ============================================================
# BeatIT
# ============================================================
APP_ENV=development
BEATIT_API_URL=http://localhost:8000

# ============================================================
# Provider-neutral model runtime
# Configure the actual compatible endpoint privately in .env.
# ============================================================
MODEL_ENABLED=true
MODEL_API_PROTOCOL=openai-compatible
MODEL_API_KEY=REPLACE_WITH_MODEL_API_KEY
MODEL_BASE_URL=http://localhost:9000/v1
MODEL_NAME=REPLACE_WITH_MODEL_NAME
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=2
INTELLIGENCE_PROVIDER=generic

# Optional local model store. Weights stay outside source control and are
# inspected lazily; empty capability paths use the metadata manifest default.
BEATIT_MODEL_ROOT=/usr/data/beatit-models
BEATIT_SEGMENTATION_MODEL=
BEATIT_LANGUAGE_MODEL=
BEATIT_EMBEDDING_MODEL=

# Optional first-party OpenAI provider; disabled by default.
OPENAI_ENABLED=false
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=REPLACE_WITH_OPENAI_MODEL

# Optional AWS artifact storage; local storage is the default.
AWS_ENABLED=false
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET=REPLACE_WITH_BUCKET_NAME
ARTIFACT_ROOT=data/artifacts
BEATIT_ENSEMBLE_STORE=sqlite
BEATIT_ENSEMBLE_DB_PATH=data/beatit-ensembles.sqlite3

# Self-hosted infrastructure.
DATABASE_URL=postgresql://beatit:CHANGE_ME@localhost:5432/beatit

# Legacy per-agent routing remains supported for compatibility.
# OPENAI_API_KEY is declared above for the legacy first-party adapter.

# OpenAI model routing
OPENAI_MODEL_INTAKE=gpt-5.4-mini
OPENAI_MODEL_EXTRACTION=gpt-5.4-mini
OPENAI_MODEL_VALIDATOR=gpt-5.4-mini
OPENAI_MODEL_STATE_BUILDER=gpt-5.5
OPENAI_MODEL_ELECTROPHYSIOLOGY=gpt-5.4-mini
OPENAI_MODEL_HEMODYNAMICS=gpt-5.4-mini
OPENAI_MODEL_RECOVERY=gpt-5.5
OPENAI_MODEL_EVALUATOR=gpt-5.5
OPENAI_MODEL_FAST=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# W&B / Weave
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=hearttwin-weavehacks
NEXT_PUBLIC_WEAVE_PROJECT_URL=

# Storage
BLOB_READ_WRITE_TOKEN=

# Redis (standard protocol). Any redis:// or rediss:// URL; missing → in-memory.
REDIS_URL=

# API base
# Public base used by the Next.js frontend (web/). For local dev against the
# FastAPI backend, set the full origin; in production set the deployed API URL.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# Server-side API base.
API_BASE=/api/v1

# VISTA-3D local/tunneled model endpoint
VISTA3D_API_BASE=
VISTA3D_API_KEY=
VISTA3D_TIMEOUT_SECONDS=120
VISTA3D_ENABLED=false

# App
NEXT_PUBLIC_APP_NAME=BeatIT
HEARTTWIN_SAFETY_MODE=strict
HEARTTWIN_TRACE_MODE=weave_with_local_fallback
HEARTTWIN_REDIS_MEMORY_ENABLED=true

# ===========================================================================
# HeartTwin CareGuard (additive module — Abridge Hackathon)
# Disabled by default: with both flags false, HeartTwin behaves exactly as
# baseline (no CareGuard routes, no Anthropic calls, no careguard:* Redis keys).
# ===========================================================================

# CareGuard feature flags
CAREGUARD_ENABLED=false
NEXT_PUBLIC_CAREGUARD_ENABLED=false

# Unified BeatIT Copilot chat panel (docs/assistant/, Wave 4 — additive, off by
# default: the backend route it calls isn't mounted yet).
NEXT_PUBLIC_UNIFIED_ASSISTANT_ENABLED=false

# Anthropic (CareGuard only — HeartTwin's OpenAI/Weave stay unchanged)
# Optional fallback key: on auth/rate/connection failure of the primary, the
# CareGuard Anthropic client transparently retries with ANTHROPIC_API_KEY_FALLBACK.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FALLBACK=

CAREGUARD_MODEL_FAST=claude-haiku-4-5-20251001
CAREGUARD_MODEL_EXTRACTION=claude-sonnet-5
CAREGUARD_MODEL_FHIR=claude-sonnet-5
CAREGUARD_MODEL_MULTIMORBIDITY=claude-sonnet-5
CAREGUARD_MODEL_GUIDELINES=claude-sonnet-5
CAREGUARD_MODEL_MEDICATION_SAFETY=claude-fable-5
CAREGUARD_MODEL_PLAN_COMPOSER=claude-fable-5
CAREGUARD_MODEL_CLINICAL_CRITIC=claude-fable-5
CAREGUARD_MODEL_FALLBACK=claude-sonnet-5

CAREGUARD_ANTHROPIC_TIMEOUT_SECONDS=75
CAREGUARD_ANTHROPIC_MAX_RETRIES=2
CAREGUARD_ANTHROPIC_EFFORT=high

# Research corpus (local-first; external retrieval off by default)
CAREGUARD_LOCAL_RESEARCH_ROOT=
CAREGUARD_GUIDELINE_MANIFEST_PATH=docs/careguard/research-manifest.yaml
CAREGUARD_ALLOW_EXTERNAL_RESEARCH=false
CAREGUARD_REQUIRE_SOURCE_VERSION=true
CAREGUARD_MAX_SOURCE_AGE_DAYS=730

# Medication evidence (external calls off unless RUN_CAREGUARD_EXTERNAL_TESTS)
RXNORM_API_BASE=https://rxnav.nlm.nih.gov/REST
OPENFDA_API_BASE=https://api.fda.gov
OPENFDA_API_KEY=
DAILYMED_API_BASE=https://dailymed.nlm.nih.gov/dailymed/services/v2

# CareGuard Redis (namespaced under careguard:*; reuses REDIS_URL)
CAREGUARD_REDIS_ENABLED=true
CAREGUARD_REDIS_PREFIX=careguard
CAREGUARD_REDIS_TTL_SECONDS=86400

# CareGuard VISTA (external + optional; never bundled into the Vercel function).
# Secret-in-path deployment: effective base = {API_BASE}/x/{ENDPOINT_SECRET}.
CAREGUARD_VISTA_ENABLED=false
CAREGUARD_VISTA_API_BASE=
CAREGUARD_VISTA_ENDPOINT_SECRET=
CAREGUARD_VISTA_API_KEY=
CAREGUARD_VISTA_TIMEOUT_SECONDS=120

# Privacy
CAREGUARD_ALLOW_IDENTIFIABLE_DATA=false
CAREGUARD_LOG_RAW_MODEL_INPUTS=false
CAREGUARD_LOG_RAW_MODEL_OUTPUTS=false
CAREGUARD_REQUIRE_DEIDENTIFICATION=true

# External integration tests (opt-in; default mocked)
RUN_CAREGUARD_EXTERNAL_TESTS=false

# ---------------------------------------------------------------------------
# CareGuard — Multimorbidity Medication Safety & Alternative-Review engine
# ---------------------------------------------------------------------------
CAREGUARD_MEDICATION_SAFETY_ENABLED=true
NEXT_PUBLIC_CAREGUARD_MEDICATION_SAFETY_ENABLED=true

CAREGUARD_MODEL_MEDICATION_SAFETY_FALLBACK=claude-sonnet-5
CAREGUARD_MODEL_REPORT_EXTRACTION=claude-sonnet-5
CAREGUARD_MEDICATION_AGENT_TIMEOUT_SECONDS=75
CAREGUARD_MEDICATION_AGENT_MAX_RETRIES=2

# Authoritative sources (tier A)
RXCLASS_API_BASE=https://rxnav.nlm.nih.gov/REST/rxclass
ORANGE_BOOK_DATA_PATH=
ORANGE_BOOK_VERSION=

# Supplemental curated sources (tier B) — local approved data only, never scraped
DDINTER_ENABLED=true
DDINTER_DATA_PATH=
DDINTER_VERSION=
DRUGCENTRAL_ENABLED=true
DRUGCENTRAL_DATA_PATH=
DRUGCENTRAL_VERSION=
SIDER_ENABLED=true
SIDER_DATA_PATH=
SIDER_VERSION=4.1

# Licensed source (tier C) — refuses to load unless the license is confirmed
DRUGBANK_ENABLED=false
DRUGBANK_LICENSE_CONFIRMED=false
DRUGBANK_DATA_PATH=

# Source policy
CAREGUARD_REQUIRE_OFFICIAL_LABEL_FOR_HARD_BLOCK=true
CAREGUARD_REQUIRE_GUIDELINE_FOR_ALTERNATIVES=true
CAREGUARD_ALLOW_UNVERIFIED_ALTERNATIVES=false
CAREGUARD_SOURCE_CACHE_TTL_SECONDS=86400
CAREGUARD_MAX_LABEL_AGE_DAYS=365

# ===========================================================================
# HeartTwin CareGuard — Verified CT Imaging + VISTA-3D extension (additive)
# Everything below is OFF by default. With these flags false the imaging
# extension performs audit/manifest work only and never runs live segmentation.
# CT is fused into a clinical case ONLY on independently verified same-subject
# linkage — never demographic/phenotype similarity.
# ===========================================================================

# Extended VISTA-3D orchestration (complements the existing VISTA3D_* / CAREGUARD_VISTA_* vars)
CAREGUARD_VISTA_HEALTH_PATH=/health
CAREGUARD_VISTA_CAPABILITIES_PATH=/capabilities
CAREGUARD_VISTA_JOB_PATH=/jobs
CAREGUARD_VISTA_USE_SIGNED_URLS=true
CAREGUARD_VISTA_MAX_CONCURRENCY=2
CAREGUARD_VISTA_MAX_RETRIES=2
CAREGUARD_VISTA_POLL_INTERVAL_SECONDS=5
CAREGUARD_VISTA_MAX_JOB_SECONDS=900
CAREGUARD_VISTA_INPUT_BUCKET_PREFIX=careguard/vista/input
CAREGUARD_VISTA_OUTPUT_BUCKET_PREFIX=careguard/vista/output
CAREGUARD_VISTA_STORE_RAW_RESPONSE=false
CAREGUARD_VISTA_REQUIRE_DEIDENTIFIED_INPUT=true
CAREGUARD_VISTA_ALLOW_INTERACTIVE_REFINEMENT=false
RUN_VISTA_EXTERNAL_TESTS=false

# Imaging source: MultiD4CAD (controlled access, DUA required) — Tier 1 linked cardiac CT
MULTID4CAD_ENABLED=true
MULTID4CAD_ROOT=
MULTID4CAD_ACCESS_APPROVED=false
MULTID4CAD_DUA_RECORDED=false
MULTID4CAD_VERSION=
MULTID4CAD_DOI=10.5281/zenodo.15148653

# Imaging source: ImageCAS (~1000 coronary CTA, controlled request) — Tier 3 imaging-only
IMAGECAS_ENABLED=true
IMAGECAS_ROOT=
IMAGECAS_VERSION=
IMAGECAS_LICENSE_RECORDED=false

# Imaging source: TotalSegmentator dataset (CC BY 4.0, open) — Tier 4 anatomy benchmark
TOTALSEGMENTATOR_DATASET_ENABLED=true
TOTALSEGMENTATOR_DATASET_ROOT=
TOTALSEGMENTATOR_DATASET_VERSION=2.0.1
TOTALSEGMENTATOR_LICENSE_RECORDED=false
# Number of subjects to import when acquiring a small open subset (0 = manifest only)
TOTALSEGMENTATOR_SUBSET_SIZE=6

# Imaging source: TCIA / RAD-ChestCT (controlled) — Tier 2 / Tier 5
TCIA_ENABLED=false
RAD_CHESTCT_ENABLED=false
