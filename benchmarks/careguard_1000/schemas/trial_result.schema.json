{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Per-trial raw result record",
  "type": "object",
  "additionalProperties": true,
  "required": ["case_id", "arm_id", "trial_id", "status"],
  "properties": {
    "case_id": {"type": "string"},
    "arm_id": {"type": "string"},
    "trial_id": {"type": "string"},
    "model_id": {"type": ["string", "null"]},
    "status": {
      "type": "string",
      "enum": ["ok", "schema_failure", "api_failure", "abstained",
               "not_executed", "repaired"]
    },
    "output": {"type": ["object", "null"]},
    "raw_output_present": {"type": "boolean"},
    "usage": {"type": "object"},
    "cost_usd": {"type": "number"},
    "latency_seconds": {"type": "number"},
    "stop_reason": {"type": ["string", "null"]},
    "request_id": {"type": ["string", "null"]},
    "retry_count": {"type": "integer"},
    "error_type": {"type": ["string", "null"]},
    "tool_call_count": {"type": "integer"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"}
  }
}
