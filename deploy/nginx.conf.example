# BeatIT self-hosted reverse-proxy example.
# Bind nginx publicly; keep Next.js and FastAPI on loopback.
upstream beatit_web { server 127.0.0.1:3001; }
upstream beatit_api { server 127.0.0.1:8000; }

server {
    listen 80;
    server_name beatit.example.invalid;
    client_max_body_size 25m;
    proxy_read_timeout 120s;
    gzip on;
    gzip_types application/json text/plain text/css application/javascript;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    location /api/ {
        proxy_pass http://beatit_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://beatit_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
